# Server-side only. Nothing here may ever get a NEXT_PUBLIC_ prefix.
DATABASE_URL=
# Live "Run a domain" page. Without RUN_PASSCODE the page is switched off.
RUN_PASSCODE=
# Whole-day model-call cap shared with the CLI (UTC day). Set it to your real Gemini free-tier limit.
LIVE_DAILY_CALL_BUDGET=
# Optional: without it, live runs fetch and clean but skip extraction.
GEMINI_API_KEY=
# Optional: salt for hashing visitor IPs (defaults to RUN_PASSCODE).
RATE_LIMIT_SALT=
