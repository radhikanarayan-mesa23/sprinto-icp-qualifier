# Server-side only. Nothing here may ever get a NEXT_PUBLIC_ prefix.
DATABASE_URL=
# Live "Run a domain" page: an open demo, no passcode and no sign-in. Switch it off with LIVE_RUNS_DISABLED=1.
LIVE_RUNS_DISABLED=
# Whole-day model-call cap shared with the CLI (UTC day). Set it to your real Gemini free-tier limit.
LIVE_DAILY_CALL_BUDGET=
# The model key (Gemini Flash through OpenRouter). Without it, live runs fetch and clean but skip extraction.
OPENROUTER_API_KEY=
RATE_LIMIT_SALT=
# Free alternative to OpenRouter: set MODEL_PRESET=gemini_free and put a free key from https://aistudio.google.com/apikey in GEMINI_API_KEY.
MODEL_PRESET=
GEMINI_API_KEY=
# Live page contact search and draft. Without the key a run still qualifies but finds no contact and writes no draft.
HUNTER_API_KEY=
# How many of the 25 monthly Hunter searches the public page may use (default 10); the CLI keeps the rest.
LIVE_HUNTER_MONTHLY_CAP=
# Pages the live run may fetch beyond the homepage (default and maximum: the config value, 4; 3 fits the 60 s limit better).
LIVE_FETCH_CAP=
# JS-built sites: thin pages are re-read through a rendering reader. Set READER_DISABLED=1 to turn that off; JINA_API_KEY raises its rate limit.
READER_DISABLED=
JINA_API_KEY=
